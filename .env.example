# Server Port
PORT=8080

# Neon PostgreSQL Database Connection
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-crimson-grass-b5bw346l-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your_neon_password_here

# S3-Compatible Cloud Storage Credentials
