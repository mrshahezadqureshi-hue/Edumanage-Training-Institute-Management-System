<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Attendance Management - EduManage</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css">
<style>
.att-wrap{max-width:1400px}.att-hero{display:flex;justify-content:space-between;gap:18px;align-items:center;flex-wrap:wrap;margin-bottom:20px}.att-hero h2{margin:0 0 5px}.att-hero p{margin:0;color:var(--text-muted);font-size:13px}.att-card{padding:22px;border-radius:18px;box-shadow:var(--shadow);margin-bottom:18px}.att-filter{display:grid;grid-template-columns:1.5fr 1fr auto;gap:12px;align-items:end}.field label{display:block;font-size:11px;font-weight:800;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:7px}.field select,.field input{width:100%;box-sizing:border-box;padding:11px 13px;border:1px solid var(--border);border-radius:10px;background:var(--surface-alt);color:var(--text);font-size:13px;outline:none}.mini-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:18px 0}.mini-stat{padding:15px 17px;border:1px solid var(--border);border-radius:14px;background:var(--surface-alt)}.mini-stat span{display:block;color:var(--text-muted);font-size:11px;font-weight:800;text-transform:uppercase}.mini-stat strong{display:block;font-size:24px;margin-top:3px}.toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin:18px 0 12px}.tools{display:flex;gap:7px;flex-wrap:wrap}.tool-btn{border:1px solid var(--border);background:var(--surface-alt);color:var(--text);padding:8px 11px;border-radius:9px;cursor:pointer;font-size:12px;font-weight:700}.tool-btn:hover{border-color:var(--primary)}.search{padding:9px 12px;border:1px solid var(--border);border-radius:9px;background:var(--surface-alt);color:var(--text);min-width:220px}.table-wrap{overflow:auto;border:1px solid var(--border);border-radius:13px}.att-table{width:100%;border-collapse:collapse;min-width:780px}.att-table th{font-size:11px;text-transform:uppercase;letter-spacing:.35px;color:var(--text-muted);background:var(--surface-alt);padding:12px 10px;text-align:left}.att-table td{padding:11px 10px;border-top:1px solid var(--border);font-size:13px}.status-select{min-width:125px;padding:8px;border:1px solid var(--border);border-radius:8px;background:var(--surface-alt);color:var(--text);font-weight:700}.summary-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:13px}.summary-item{padding:12px 15px;border:1px solid var(--border);border-radius:11px}.summary-item span{display:block;color:var(--text-muted);font-size:11px;font-weight:800;text-transform:uppercase}.summary-item strong{font-size:22px}.tabs{display:flex;gap:7px;border-bottom:1px solid var(--border);margin:-5px 0 18px;padding-bottom:10px}.tab{border:0;background:transparent;color:var(--text-muted);padding:9px 13px;border-radius:9px;cursor:pointer;font-weight:800}.tab.active{background:var(--primary);color:#fff}.report-filter{display:flex;justify-content:space-between;align-items:end;gap:12px;flex-wrap:wrap;margin-bottom:14px}.report-table{min-width:760px}.pct{font-weight:900}.good{color:#059669}.warn{color:#d97706}.bad{color:#dc2626}.empty{text-align:center;padding:38px;color:var(--text-muted)}.empty i{font-size:34px;color:var(--primary);margin-bottom:10px}.print-only{display:none}@media(max-width:850px){.att-filter{grid-template-columns:1fr}.mini-stats{grid-template-columns:repeat(2,1fr)}.summary-grid{grid-template-columns:1fr}.search{min-width:180px}}
@media print{.dashboard-layout .main-content{margin:0!important}.att-card:not(.print-card),.att-hero,.tabs,.toolbar .tools,.search,.no-print,.admin-sidebar{display:none!important}.print-only{display:block}.table-wrap{overflow:visible}.att-table{min-width:100%}}
</style>
</head>
<body>
<div class="dashboard-layout"><jsp:include page="/WEB-INF/views/common/admin-sidebar.jsp" />
<main class="main-content"><div class="att-wrap">
<div class="att-hero"><div><h2><i class="fas fa-calendar-check" style="color:var(--primary)"></i> Attendance Management</h2><p>Professional daily register, quick marking and monthly attendance analysis.</p></div><a href="${pageContext.request.contextPath}/admin/dashboard" class="no-print"><button type="button" class="mini-btn" style="padding:10px 17px"><i class="fas fa-arrow-left"></i> Dashboard</button></a></div>
<c:if test="${not empty attendanceMessage}"><div class="alert alert-success no-print"><i class="fas fa-circle-check"></i> ${attendanceMessage}</div></c:if>
<div class="att-card no-print"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:15px"><div><h3 style="margin:0;font-size:16px">Attendance Register</h3><span style="font-size:12px;color:var(--text-muted)">Select a batch and date to manage attendance</span></div></div>
<form action="${pageContext.request.contextPath}/admin/attendance" method="get" class="att-filter">
<div class="field"><label>Batch</label><select name="batchId" required><option value="">Select Batch</option><c:forEach var="b" items="${batches}"><option value="${b.id}" ${selectedBatch != null && selectedBatch.id == b.id ? 'selected' : ''}>${b.batchName} — ${b.courseName}</option></c:forEach></select></div>
<div class="field"><label>Date</label><input type="date" name="date" value="${selectedDate}" required></div>
<button class="btn-primary" style="padding:11px 20px;white-space:nowrap"><i class="fas fa-search"></i> Open Register</button>
</form></div>
<c:if test="${selectedBatch != null}">
<div class="att-card print-card">
<div class="print-only"><h2>EduManage — Attendance Register</h2><p>${selectedBatch.batchName} | ${selectedBatch.courseName} | ${selectedDate}</p></div>
<div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap"><div><h3 style="margin:0 0 4px">${selectedBatch.batchName}</h3><span style="color:var(--text-muted);font-size:12.5px">${selectedBatch.courseName} &nbsp;•&nbsp; ${selectedDate}</span></div><span class="badge badge-approved"><i class="fas fa-users"></i> ${fn:length(selectedBatch.students)} Students</span></div>
<div class="mini-stats"><div class="mini-stat"><span>Total Students</span><strong>${fn:length(selectedBatch.students)}</strong></div><div class="mini-stat"><span>Present</span><strong id="presentCount">0</strong></div><div class="mini-stat"><span>Absent</span><strong id="absentCount">0</strong></div><div class="mini-stat"><span>Late</span><strong id="lateCount">0</strong></div></div>
<div class="toolbar no-print"><div class="tools"><button type="button" class="tool-btn" onclick="setAll('PRESENT')"><i class="fas fa-check"></i> All Present</button><button type="button" class="tool-btn" onclick="setAll('ABSENT')"><i class="fas fa-xmark"></i> All Absent</button><button type="button" class="tool-btn" onclick="setAll('LATE')"><i class="fas fa-clock"></i> All Late</button><button type="button" class="tool-btn" onclick="goDate(-1)"><i class="fas fa-chevron-left"></i> Previous</button><button type="button" class="tool-btn" onclick="goDate(0)"><i class="fas fa-calendar-day"></i> Today</button><button type="button" class="tool-btn" onclick="goDate(1)">Next <i class="fas fa-chevron-right"></i></button><button type="button" class="tool-btn" onclick="window.print()"><i class="fas fa-print"></i> Print</button><button type="button" class="tool-btn" onclick="exportCSV()"><i class="fas fa-file-csv"></i> CSV</button></div><input id="studentSearch" class="search" placeholder="Search student..." onkeyup="filterStudents()"></div>
<c:choose><c:when test="${not empty selectedBatch.students}">
<form action="${pageContext.request.contextPath}/admin/attendance/save" method="post" id="attendanceForm"><input type="hidden" name="batchId" value="${selectedBatch.id}"><input type="hidden" name="date" value="${selectedDate}">
<div class="table-wrap"><table class="att-table" id="attendanceTable"><thead><tr><th style="width:50px">#</th><th>Student</th><th>Email</th><th style="text-align:center">Status</th></tr></thead><tbody>
<c:forEach var="s" items="${selectedBatch.students}" varStatus="st"><tr class="student-row"><td>${st.count}</td><td class="student-name"><strong>${s.fullName}</strong><small style="display:block;color:var(--primary);font-family:monospace">@${s.username}</small></td><td>${s.email != null ? s.email : '-'}</td><td style="text-align:center"><select name="status_${s.id}" class="status-select"><option value="PRESENT" ${statusMap[s.id] == 'PRESENT' ? 'selected' : ''}>Present</option><option value="ABSENT" ${statusMap[s.id] == 'ABSENT' ? 'selected' : ''}>Absent</option><option value="LATE" ${statusMap[s.id] == 'LATE' ? 'selected' : ''}>Late</option></select></td></tr></c:forEach>
</tbody></table></div>
<div class="summary-grid"><div class="summary-item"><span>Present Rate</span><strong id="presentRate">0%</strong></div><div class="summary-item"><span>Absent Rate</span><strong id="absentRate">0%</strong></div><div class="summary-item"><span>Late Rate</span><strong id="lateRate">0%</strong></div></div>
<div class="no-print" style="display:flex;justify-content:flex-end;margin-top:15px"><button type="submit" class="btn-primary" style="width:auto;padding:11px 24px"><i class="fas fa-save"></i> Save Attendance</button></div>
</form></c:when><c:otherwise><div class="empty"><i class="fas fa-user-slash"></i><strong style="display:block;color:var(--text)">No students assigned</strong>Assign students to this batch first.</div></c:otherwise></c:choose>
</div>
<div class="att-card no-print"><div class="tabs"><button class="tab active" id="dailyTab" onclick="showTab('daily')"><i class="fas fa-list-check"></i> Daily Register</button><button class="tab" id="monthlyTab" onclick="showTab('monthly')"><i class="fas fa-chart-column"></i> Monthly Report</button></div>
<div id="monthlyPanel" style="display:none"><form action="${pageContext.request.contextPath}/admin/attendance" method="get" class="report-filter"><input type="hidden" name="batchId" value="${selectedBatch.id}"><input type="hidden" name="date" value="${selectedDate}"><div class="field"><label>Report Month</label><input type="month" name="month" value="${selectedMonth}" required></div><button class="btn-primary" style="padding:10px 18px"><i class="fas fa-chart-pie"></i> Generate Report</button></form>
<div class="table-wrap"><table class="att-table report-table"><thead><tr><th>#</th><th>Student</th><th>Present</th><th>Absent</th><th>Late</th><th>Marked Days</th><th>Attendance %</th></tr></thead><tbody><c:forEach var="r" items="${monthlyReport}" varStatus="rs"><tr><td>${rs.count}</td><td><strong>${r.student.fullName}</strong><small style="display:block;color:var(--primary)">@${r.student.username}</small></td><td>${r.present}</td><td>${r.absent}</td><td>${r.late}</td><td>${r.total}</td><td class="pct ${r.percentage >= 75 ? 'good' : (r.percentage >= 60 ? 'warn' : 'bad')}">${r.percentage}%</td></tr></c:forEach><c:if test="${empty monthlyReport}"><tr><td colspan="7" style="text-align:center;padding:25px">No attendance data for this month.</td></tr></c:if></tbody></table></div>
<p style="font-size:11.5px;color:var(--text-muted);margin-top:10px">Attendance percentage counts Present as full attendance and Late as 50% attendance.</p></div>
</div>
</c:if>
</div><jsp:include page="/WEB-INF/views/common/admin-footer.jsp" />
<script>
function setAll(v){document.querySelectorAll('.status-select').forEach(s=>s.value=v);updateCounts()}
function updateCounts(){let p=0,a=0,l=0;document.querySelectorAll('.status-select').forEach(s=>{if(s.value==='PRESENT')p++;else if(s.value==='ABSENT')a++;else l++});let t=p+a+l;document.getElementById('presentCount').textContent=p;document.getElementById('absentCount').textContent=a;document.getElementById('lateCount').textContent=l;document.getElementById('presentRate').textContent=(t?Math.round(p*1000/t)/10:0)+'%';document.getElementById('absentRate').textContent=(t?Math.round(a*1000/t)/10:0)+'%';document.getElementById('lateRate').textContent=(t?Math.round(l*1000/t)/10:0)+'%'}
function filterStudents(){let q=document.getElementById('studentSearch').value.toLowerCase();document.querySelectorAll('.student-row').forEach(r=>r.style.display=r.innerText.toLowerCase().includes(q)?'':'none')}
function goDate(dir){let d=document.querySelector('input[name="date"]');if(!d)return;let x=new Date(d.value+'T00:00:00');if(dir===0)x=new Date();else x.setDate(x.getDate()+dir);let iso=x.toISOString().slice(0,10);let batch='${selectedBatch != null ? selectedBatch.id : ''}';if(batch)window.location='${pageContext.request.contextPath}/admin/attendance?batchId='+batch+'&date='+iso}
function exportCSV(){let rows=[['#','Student','Email','Status']];document.querySelectorAll('#attendanceTable tbody tr').forEach(r=>{if(r.style.display==='none')return;let c=r.querySelectorAll('td');rows.push([c[0].innerText,c[1].innerText.replace(/\n/g,' '),c[2].innerText,c[3].querySelector('select').value])});let csv=rows.map(r=>r.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(',')).join('\n');let a=document.createElement('a');a.href='data:text/csv;charset=utf-8,'+encodeURIComponent(csv);a.download='attendance_${selectedBatch != null ? selectedBatch.batchName : 'register'}_${selectedDate}.csv';a.click()}
function showTab(t){let daily=t==='daily';document.getElementById('monthlyPanel').style.display=daily?'none':'block';document.getElementById('dailyTab').classList.toggle('active',daily);document.getElementById('monthlyTab').classList.toggle('active',!daily)}
document.addEventListener('DOMContentLoaded',()=>{document.querySelectorAll('.status-select').forEach(s=>s.addEventListener('change',updateCounts));updateCounts()});
</script>
</body></html>
